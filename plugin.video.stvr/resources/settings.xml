<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<settings version="1">
    <section id="plugin.video.stvr">
        <category id="playback" label="30100">
            <group id="1">
                <setting id="max_quality" type="integer" label="30106" help="30113">
                    <level>0</level>
                    <default>0</default>
                    <constraints>
                        <options>
                            <option label="30107">0</option>
                            <option label="30108">1</option>
                            <option label="30109">2</option>
                            <option label="30110">3</option>
                            <option label="30111">4</option>
                        </options>
                    </constraints>
                    <control type="spinner" format="string"/>
                </setting>
                <setting id="subtitles" type="boolean" label="30112">
                    <level>0</level>
                    <default>true</default>
                    <control type="toggle"/>
                </setting>
            </group>
            <group id="2" label="30114">
                <setting id="use_isa" type="boolean" label="30101" help="30102">
                    <level>1</level>
                    <default>false</default>
                    <control type="toggle"/>
                </setting>
                <setting id="isa_manifest" type="integer" label="30103" parent="use_isa">
                    <level>1</level>
                    <default>0</default>
                    <constraints>
                        <options>
                            <option label="30104">0</option>
                            <option label="30105">1</option>
                        </options>
                    </constraints>
                    <dependencies>
                        <dependency type="enable" setting="use_isa">true</dependency>
                    </dependencies>
                    <control type="spinner" format="string"/>
                </setting>
            </group>
        </category>
        <category id="general" label="30120">
            <group id="1">
                <setting id="page_size" type="integer" label="30121">
                    <level>0</level>
                    <default>30</default>
                    <constraints>
                        <minimum>10</minimum>
                        <step>10</step>
                        <maximum>100</maximum>
                    </constraints>
                    <control type="slider" format="integer"/>
                </setting>
                <setting id="fetch_duration" type="boolean" label="30122" help="30125">
                    <level>0</level>
                    <default>true</default>
                    <control type="toggle"/>
                </setting>
                <setting id="cache_ttl" type="integer" label="30123">
                    <level>1</level>
                    <default>30</default>
                    <constraints>
                        <minimum>0</minimum>
                        <step>10</step>
                        <maximum>240</maximum>
                    </constraints>
                    <control type="slider" format="integer"/>
                </setting>
                <setting id="clear_cache" type="action" label="30124">
                    <level>0</level>
                    <data>RunPlugin(plugin://plugin.video.stvr/?action=clear_cache)</data>
                    <constraints>
                        <allowempty>true</allowempty>
                    </constraints>
                    <control type="button" format="action">
                        <close>true</close>
                    </control>
                </setting>
            </group>
        </category>
    </section>
</settings>
